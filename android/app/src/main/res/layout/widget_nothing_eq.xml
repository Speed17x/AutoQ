<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_nothing"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="11dp"
    android:paddingRight="14dp"
    android:paddingBottom="11dp">

    <!-- Top Nothing OS Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_status_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_red" />

        <ImageView
            android:id="@+id/widget_dot_title"
            android:layout_width="0dp"
            android:layout_height="15dp"
            android:layout_weight="1"
            android:contentDescription="Dispositivo Moondrop"
            android:scaleType="fitStart" />

        <TextView
            android:id="@+id/widget_transport_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="USB·5B"
            android:textColor="#8E929B"
            android:textSize="9sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/widget_btn_power_wrap"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:minWidth="42dp">

            <ImageView
                android:id="@+id/widget_btn_power_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_pill_red" />

            <TextView
                android:id="@+id/widget_btn_power"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:minWidth="42dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="ON"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <!-- Middle Dot-Grid Curve Canvas (tapping opens full app) -->
    <FrameLayout
        android:id="@+id/widget_graph_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_graph_frame"
        android:padding="4dp">

        <ImageView
            android:id="@+id/widget_curve_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Curva de ecualización"
            android:scaleType="fitXY" />
    </FrameLayout>

    <!-- Bottom Minimal Nothing Control Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_prev"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_pill_dark"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="‹"
            android:textColor="#F5F5F5"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_preset_label"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_dark"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="CHU 2 STOCK"
            android:textColor="#F5F5F5"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_next"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_pill_dark"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="›"
            android:textColor="#F5F5F5"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_open"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/widget_pill_dark"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="EQ"
            android:textColor="#D71921"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
