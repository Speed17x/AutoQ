// ============================================================================
// Módulo opcional de Waybar para Trivium
// ============================================================================
// 1. Agrega "custom/trivium" en "modules-right" de ~/.config/waybar/config.jsonc
// 2. Pega este bloque dentro de ~/.config/waybar/config.jsonc:
{
  "custom/trivium": {
    "exec": "~/.local/bin/trivium-cli waybar-status",
    "return-type": "json",
    "interval": 6,
    "on-click": "~/.local/bin/trivium-widget --toggle",
    "on-click-right": "~/.local/bin/trivium-widget --full"
  }
}

