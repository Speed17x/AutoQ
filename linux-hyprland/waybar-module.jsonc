// ============================================================================
// Módulo opcional de Waybar para AutoQ (estilo Nothing OS)
// ============================================================================
// 1. Agrega "custom/autoq" en "modules-right" de ~/.config/waybar/config.jsonc
// 2. Pega este bloque dentro de ~/.config/waybar/config.jsonc:
{
  "custom/autoq": {
    "exec": "~/.local/bin/autoq-widget --status-waybar",
    "return-type": "json",
    "interval": 6,
    "on-click": "~/.local/bin/autoq-widget --toggle",
    "on-click-right": "~/.local/bin/autoq-widget --full"
  }
}

