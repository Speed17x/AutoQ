# AutoQ — Direct user-space USB HID access for supported DSP cables & DACs
# KTMicro (Moondrop Chu 2/May/Quark 2, Kiwi Ears Allegro, JCALLY, Tanchjim KTMicro)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="31b2", MODE="0666", TAG+="uaccess"
