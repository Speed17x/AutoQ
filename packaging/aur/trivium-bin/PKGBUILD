# Maintainer: Hector <https://github.com/Speed17x/Trivium>
pkgname=trivium-bin
pkgver=3.0.0
pkgrel=1
pkgdesc="Universal Parametric EQ & AutoEQ suite (precompiled native Rust GUI, multiprotocol DSP CLI & trivium-daemon)"
arch=('x86_64')
url="https://github.com/Speed17x/Trivium"
license=('GPL-2.0-or-later')
depends=('glibc' 'gcc-libs' 'libglvnd' 'libxkbcommon')
optdepends=(
    'pipewire: Universal 10-band system-wide EQ filter-chain'
    'libpulse: Audio sink discovery via pactl'
    'plasma-workspace: Native KDE Plasma 6 QML Plasmoid support'
)
provides=('trivium' 'trivium-cli' 'trivium-daemon')
conflicts=('trivium' 'autoq' 'autoq-bin')
source=(
    "trivium-${pkgver}::https://github.com/Speed17x/Trivium/releases/download/v${pkgver}/trivium-linux-x86_64"
    "trivium-cli-${pkgver}::https://github.com/Speed17x/Trivium/releases/download/v${pkgver}/trivium-cli-linux-x86_64"
    "trivium-daemon-${pkgver}::https://github.com/Speed17x/Trivium/releases/download/v${pkgver}/trivium-daemon-linux-x86_64"
    "Trivium-${pkgver}.tar.gz::https://github.com/Speed17x/Trivium/archive/refs/tags/v${pkgver}.tar.gz"
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 "${srcdir}/trivium-${pkgver}" "${pkgdir}/usr/bin/trivium"
    install -Dm755 "${srcdir}/trivium-cli-${pkgver}" "${pkgdir}/usr/bin/trivium-cli"
    install -Dm755 "${srcdir}/trivium-daemon-${pkgver}" "${pkgdir}/usr/bin/trivium-daemon"

    cd "${srcdir}/Trivium-${pkgver}"
    install -Dm644 "packaging/systemd/trivium-daemon.service" "${pkgdir}/usr/lib/systemd/user/trivium-daemon.service"
    install -Dm644 "linux-hyprland/hyprland-trivium.conf" "${pkgdir}/usr/share/trivium/widgets/linux-hyprland/hyprland-trivium.conf"
    install -Dm644 "linux-hyprland/waybar-module.jsonc" "${pkgdir}/usr/share/trivium/widgets/linux-hyprland/waybar-module.jsonc"
    install -dm755 "${pkgdir}/usr/share/trivium/widgets/linux-kde"
    cp -a "linux-kde/plasmoid" "${pkgdir}/usr/share/trivium/widgets/linux-kde/"

    install -Dm644 "linux-appimage/trivium.desktop" "${pkgdir}/usr/share/applications/trivium.desktop"
    install -Dm644 "linux-appimage/trivium.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/trivium.svg"
    install -Dm644 "packaging/udev/99-trivium-usb-dsp.rules" "${pkgdir}/usr/lib/udev/rules.d/99-trivium-usb-dsp.rules"
}
