# Maintainer: Hector <https://github.com/Speed17x/AutoQ>
pkgname=autoq
pkgver=2.1.1
pkgrel=1
pkgdesc="Universal Parametric EQ & AutoEQ suite (100% native Rust Nothing OS GUI + multiprotocol DSP CLI & autoq-daemon)"
arch=('x86_64' 'aarch64')
url="https://github.com/Speed17x/AutoQ"
license=('GPL-2.0-or-later')
depends=('glibc' 'gcc-libs' 'libglvnd' 'libxkbcommon')
optdepends=(
    'pipewire: Universal 10-band system-wide EQ filter-chain'
    'libpulse: Audio sink discovery via pactl'
    'plasma-workspace: Native KDE Plasma 6 QML Plasmoid support'
)
makedepends=('cargo')
provides=('autoq' 'autoq-cli')
conflicts=('autoq-bin')
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/Speed17x/AutoQ/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "AutoQ-${pkgver}"
    export CARGO_TARGET_DIR=target
    cargo build --release --locked --workspace
}

check() {
    cd "AutoQ-${pkgver}"
    cargo test --release --locked --workspace
}

package() {
    cd "AutoQ-${pkgver}"
    install -Dm755 "target/release/autoq-gui" "${pkgdir}/usr/bin/autoq"
    install -Dm755 "target/release/autoq-cli" "${pkgdir}/usr/bin/autoq-cli"
    install -Dm755 "target/release/autoq-daemon" "${pkgdir}/usr/bin/autoq-daemon"
    install -Dm644 "packaging/systemd/autoq-daemon.service" "${pkgdir}/usr/lib/systemd/user/autoq-daemon.service"

    install -Dm644 "linux-hyprland/hyprland-autoq.conf" "${pkgdir}/usr/share/autoq/widgets/linux-hyprland/hyprland-autoq.conf"
    install -Dm644 "linux-hyprland/waybar-module.jsonc" "${pkgdir}/usr/share/autoq/widgets/linux-hyprland/waybar-module.jsonc"
    install -dm755 "${pkgdir}/usr/share/autoq/widgets/linux-kde"
    cp -a "linux-kde/plasmoid" "${pkgdir}/usr/share/autoq/widgets/linux-kde/"

    install -Dm644 "linux-appimage/autoq.desktop" "${pkgdir}/usr/share/applications/autoq.desktop"
    install -Dm644 "linux-appimage/autoq.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/autoq.svg"
    install -Dm644 "packaging/udev/99-autoq-usb-dsp.rules" "${pkgdir}/usr/lib/udev/rules.d/99-autoq-usb-dsp.rules"
}
